# ──────────────────────────────────────────────────────────────────────────────
# GLDIS — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# Database (SQLite for local dev; swap to PostgreSQL for production)
DATABASE_URL=sqlite:///./data/gldis.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/gldis

# ── OpenAI (for draft generation + VLM fallback) ──────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Shared LLM Provider (choose one: lmstudio, ollama, openai) ───────────────
# Leave blank to keep the legacy auto-selection behavior.
LLM_PROVIDER=
# Shared defaults used when LLM_PROVIDER is set to lmstudio or ollama.
LLM_MODEL=qwen/qwen3-vl-4b
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MAX_TOKENS=1200

# ── VLM (Qwen2.5-VL via LM Studio — primary document understanding) ───────────
# 1. Download Qwen2.5-VL-7B-Instruct from Hugging Face
# 2. Load it in LM Studio (https://lmstudio.ai)
# 3. Start the local server on port 1234
# 4. Set VLM_ENABLED=true below
VLM_ENABLED=false
VLM_MODEL=qwen2.5-vl-7b-instruct
VLM_API_BASE=http://localhost:1234/v1
VLM_CONFIDENCE_THRESHOLD=0.6
VLM_MAX_TOKENS=4000

# ── OCR (Tesseract — fallback when VLM is unavailable) ────────────────────────
# Windows: install from https://github.com/tesseract-ocr/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: TESSERACT_CMD=tesseract

# ── Embedding Model (downloaded from Hugging Face on first run) ───────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_BATCH_SIZE=32

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
FAISS_INDEX_PATH=./data/faiss_index
BM25_INDEX_PATH=./data/bm25_index
FEEDBACK_STORE_PATH=./data/feedback

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=75

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5

# ── Generation ────────────────────────────────────────────────────────────────
MAX_EVIDENCE_TOKENS=3000
GENERATION_TEMPERATURE=0.1

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
